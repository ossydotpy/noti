# Django
DJANGO_ENV=dev
SECRET_KEY=change-me
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (defaults to sqlite in ./.db.sqlite3 when unset)
# DATABASE_URL=postgres://noti:noti@localhost:5432/noti

# Cache / broker
REDIS_URL=redis://localhost:6379/1
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Encryption (sensitive data at rest; also the default SAT secret)
FERNET_KEY=

# Auth (SimpleJWT)
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_ROTATE_REFRESH_TOKENS=true
JWT_BLACKLIST_AFTER_ROTATION=true

# CORS (allowed browser origins, comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Email (Django SMTP; leave SMTP_HOST empty in dev to use the console backend)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
DEFAULT_FROM_EMAIL=noti@example.com

# Subscriber Access Tokens (in-app SDK sessions)
SAT_SECRET_KEY=
SAT_ISSUER=noti
SAT_AUDIENCE=in_app
SAT_ACCESS_TOKEN_EXPIRY=900
SAT_REFRESH_TOKEN_EXPIRY=2592000

# Push / SMS providers are configured per-workspace at runtime (dashboard),
# not via environment variables.

# Web
FRONTEND_URL=http://localhost:3000

# Observability (OpenTelemetry; ships traces + logs to any OTLP backend)
OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_EXPORTER_OTLP_PROTOCOL=grpc
# OTEL_SERVICE_NAME=noti-backend
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment=dev,service.version=0.1.0
# OTEL_TRACES_EXPORTER=otlp
# OTEL_LOGS_EXPORTER=otlp

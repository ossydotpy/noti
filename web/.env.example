# noti web — environment variables
# All VITE_* vars are statically inlined into the client bundle at build time.

# Base URL of the Django API. Must include the /api path prefix.
VITE_API_URL=http://localhost:8000/api

# Auth tokens are stored in localStorage (not an env var):
#   noti.access — JWT access token (15 min default)
#   noti.refresh — JWT refresh token (7 days default)
# Configure token lifetimes on the backend (JWT_* settings in backend/.env).
